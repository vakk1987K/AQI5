  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f172a",
  "theme_color": "#0284c7",
  "lang": "en",
  "dir": "ltr",
  "categories": ["weather", "health", "utilities", "lifestyle"],
  "icons": [
